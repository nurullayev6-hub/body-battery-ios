# Сборка и отправка в TestFlight без Mac: всё делает GitHub Actions.
# Секреты: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8, APPLE_TEAM_ID, BUNDLE_ID
default_platform(:ios)

platform :ios do
  lane :beta do
    bundle_id = ENV.fetch("BUNDLE_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      duration: 1200,
      in_house: false
    )

    setup_ci # временная связка ключей на сборочной машине

    # Свежий сертификат распространения на каждую сборку; в конце отзываем его,
    # чтобы не упереться в лимит Apple. Загруженные в TestFlight сборки от этого не страдают.
    cert(api_key: api_key, development: false, generate_apple_certs: true)
    cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]

    begin
      sigh(api_key: api_key, app_identifier: bundle_id, force: true)
      profile = lane_context[SharedValues::SIGH_NAME]

      build_number = (ENV["GITHUB_RUN_NUMBER"] || "1").to_s
      build_app(
        project: "Rezerv.xcodeproj",
        scheme: "Rezerv",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        output_name: "Rezerv.ipa",
        xcargs: [
          "DEVELOPMENT_TEAM=#{team_id}",
          "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
          "CODE_SIGN_STYLE=Manual",
          "CODE_SIGN_IDENTITY='Apple Distribution'",
          "PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
          "CURRENT_PROJECT_VERSION=#{build_number}"
        ].join(" "),
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: { bundle_id => profile }
        }
      )

      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    ensure
      if cert_id
        begin
          Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
          c = Spaceship::ConnectAPI::Certificate.all.find { |x| x.id == cert_id }
          c&.delete!
          UI.message("Временный сертификат отозван")
        rescue => e
          UI.important("Не удалось отозвать сертификат: #{e.message}")
        end
      end
    end
  end
end
